[Unit]
Description=VNC da tela virtual (só local; acesso pelo túnel SSH)
After=infopro-xvfb.service
Requires=infopro-xvfb.service
[Service]
ExecStart=/usr/bin/x11vnc -display :99 -localhost -nopw -forever -shared -rfbport 5900 -noxdamage
Restart=always
RestartSec=3
[Install]
WantedBy=multi-user.target
