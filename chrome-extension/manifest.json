{
  "manifest_version": 3,
  "name": "Infopro Assistant (POC)",
  "version": "0.1.0",
  "description": "Orbe do Assistant em outras abas do Chrome, sincronizada com a sessão de foco do sistema (mesma tabela do Supabase).",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png" },
    "default_title": "Infopro Assistant"
  },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage", "alarms", "tabs"],
  "host_permissions": ["https://*.supabase.co/*"],
  "content_scripts": [
    {
      "matches": ["http://localhost:5183/*", "http://localhost:8080/*", "https://SEU-DOMINIO-AQUI.exemplo.com/*"],
      "js": ["config.js", "bridge.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "exclude_matches": ["http://localhost:5183/*", "http://localhost:8080/*", "https://SEU-DOMINIO-AQUI.exemplo.com/*"],
      "js": ["config.js", "orb.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/*.png"],
      "matches": ["<all_urls>"]
    }
  ]
}
